      "officeFabricIconFontName": "GridViewMedium",
      "properties": {
        "listId": "",
        "columns": 4,
        "sectionTitle": "",
        "openInNewTab": true,
        "titleField": "Title",
        "videoField": "Video",
        "labelImageField": "Image0",
        "mainImageField": ""
      }
    }
  ]
}
