{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/view-formatting/tile-formatting.schema.json",
  "height": 140,
  "width": 160,
  "hideSelection": true,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "a",
    "attributes": {
      "href": "[$QLink.Url]",
      "target": "_blank",
      "title": "[$Title]"
    },
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "justify-content": "center",
      "width": "140px",
      "height": "120px",
      "padding": "16px 12px",
      "margin": "8px",
      "border": "1px solid #e1dfdd",
      "border-radius": "4px",
      "background-color": "#ffffff",
      "text-decoration": "none",
      "transition": "all 0.2s ease-in-out",
      "cursor": "pointer",
      "box-shadow": "0 1px 2px rgba(0,0,0,0.04)",
      "font-family": "'Montserrat', 'Segoe UI', sans-serif"
    },
    "customCardProps": {
      "openOnEvent": "hover",
      "directionalHint": "bottomCenter",
      "isBeakVisible": false
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "align-items": "center",
          "justify-content": "center",
          "width": "40px",
          "height": "40px",
          "margin-bottom": "12px",
          "border-radius": "50%",
          "background-color": "#fef6f5"
        },
        "children": [
          {
            "elmType": "span",
            "attributes": {
              "iconName": "[$IconName]",
              "class": "ms-fontColor-themePrimary"
            },
            "style": {
              "font-size": "20px",
              "color": "#F9423A"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "[$Title]",
        "style": {
          "font-family": "'Barlow Condensed', 'Segoe UI', sans-serif",
          "font-size": "13px",
          "font-weight": "600",
          "text-transform": "uppercase",
          "letter-spacing": "0.5px",
          "color": "#323130",
          "text-align": "center",
          "line-height": "1.3",
          "max-width": "120px"
        }
      }
    ]
  }
}
