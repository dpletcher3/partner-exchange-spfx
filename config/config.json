{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "phillips-brand-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/phillipsBrand/PhillipsBrandApplicationCustomizer.js",
          "manifest": "./src/extensions/phillipsBrand/PhillipsBrandApplicationCustomizer.manifest.json"
        }
      ]
    },
    "phillips-news-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/phillipsNews/PhillipsNewsWebPart.js",
          "manifest": "./src/webparts/phillipsNews/PhillipsNewsWebPart.manifest.json"
        }
      ]
    },
    "phillips-personalized-hero-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/phillipsPersonalizedHero/PhillipsPersonalizedHeroWebPart.js",
          "manifest": "./src/webparts/phillipsPersonalizedHero/PhillipsPersonalizedHeroWebPart.manifest.json"
        }
      ]
    },
    "phillips-list-view-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/phillipsListView/PhillipsListViewWebPart.js",
          "manifest": "./src/webparts/phillipsListView/PhillipsListViewWebPart.manifest.json"
        }
      ]
    },
    "phillips-media-card-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/phillipsMediaCard/PhillipsMediaCardWebPart.js",
          "manifest": "./src/webparts/phillipsMediaCard/PhillipsMediaCardWebPart.manifest.json"
        }
      ]
    },
    "phillips-world-clock-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/phillipsWorldClock/PhillipsWorldClockWebPart.js",
          "manifest": "./src/webparts/phillipsWorldClock/PhillipsWorldClockWebPart.manifest.json"
        }
      ]
    },
    "phillips-media-gallery-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/phillipsMediaGallery/PhillipsMediaGalleryWebPart.js",
          "manifest": "./src/webparts/phillipsMediaGallery/PhillipsMediaGalleryWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "PhillipsBrandApplicationCustomizerStrings": "lib/extensions/phillipsBrand/loc/{locale}.js",
    "PhillipsNewsWebPartStrings": "lib/webparts/phillipsNews/loc/{locale}.js",
    "PhillipsPersonalizedHeroWebPartStrings": "lib/webparts/phillipsPersonalizedHero/loc/{locale}.js",
    "PhillipsListViewWebPartStrings": "lib/webparts/phillipsListView/loc/{locale}.js",
    "PhillipsMediaCardWebPartStrings": "lib/webparts/phillipsMediaCard/loc/{locale}.js",
    "PhillipsWorldClockWebPartStrings": "lib/webparts/phillipsWorldClock/loc/{locale}.js",
    "PhillipsMediaGalleryWebPartStrings": "lib/webparts/phillipsMediaGallery/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js"
  }
}